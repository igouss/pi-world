{
	"name": "pi-world",
	"main": "src/worker.ts",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": ["nodejs_compat"],
	"define": { "BUILD": "\"dev\"" },
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/w/*"],
		"not_found_handling": "single-page-application"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "WORLD", "class_name": "WorldCell" },
			{ "name": "ACCOUNT", "class_name": "AccountCell" },
			{ "name": "DIRECTORY", "class_name": "DirectoryCell" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldCell", "AccountCell", "DirectoryCell"] }]
}
