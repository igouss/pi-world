{
	"name": "pi-world",
	"main": "src/worker.ts",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": ["nodejs_compat", "js_rpc"],
	"define": { "BUILD": "\"dev\"" },
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*", "/w/*"],
		"not_found_handling": "single-page-application"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "WORLD", "class_name": "WorldCell" },
			{ "name": "ACCOUNT", "class_name": "AccountCell" },
			{ "name": "DIRECTORY", "class_name": "DirectoryCell" }
		]
	},
	"worker_loaders": [{ "binding": "LOADER" }],
	"r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "pi-world-snapshots" }],
	"rules": [
		{ "type": "Text", "globs": ["**/*.txt"] },
		{ "type": "Data", "globs": ["**/*.bin"] }
	],
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorldCell", "AccountCell", "DirectoryCell"] }]
}
