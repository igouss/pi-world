{
	"name": "pi-world",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"spike": "node spike/wasm-world.mjs",
		"spike:determinism": "node spike/determinism.mjs",
		"spike:registry": "node spike/registry.mjs",
		"test": "vitest --run",
		"typecheck": "npm run build:runtime && tsc -p tsconfig.json && tsc -p perf/tsconfig.json && tsc -p cli/tsconfig.json && tsc -p perf/bench/tsconfig.json",
		"build:ui": "esbuild ui/main.tsx --bundle --format=esm --target=es2022 --jsx=automatic --jsx-import-source=preact --minify --sourcemap --outfile=public/app.js",
		"dev": "npm run build && celld dev . --port 8791",
		"deploy": "npm run typecheck && npm test && npm run build && sh scripts/deploy.sh",
		"build:runtime": "mkdir -p dist/runtime && esbuild src/isolate/runtime/runtime-entry.ts --bundle --format=esm --platform=neutral --external:cloudflare:workers --external:./quickjs.wasm --minify --outfile=dist/runtime/world-runtime.txt && sha256sum dist/runtime/world-runtime.txt | cut -c1-16 > dist/runtime/world-runtime-hash.txt && cp node_modules/quickjs-wasi/quickjs.wasm dist/runtime/quickjs.bin",
		"build": "npm run build:runtime && npm run build:ui",
		"mutate": "stryker run",
		"tla": "sh spec/tla/check.sh",
		"spike:memory": "esbuild spike/memory/vm.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/spike/memory-vm.mjs --log-level=warning && node dist/spike/memory-vm.mjs",
		"perf": "node perf/bin/perf.ts",
		"bench:call-path": "esbuild perf/bench/call-path.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bench/call-path.mjs --log-level=warning && node dist/bench/call-path.mjs",
		"bench:snapshot-pages": "esbuild perf/bench/snapshot-pages.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/bench/snapshot-pages.mjs --log-level=warning && node dist/bench/snapshot-pages.mjs",
		"pw": "node cli/pw.ts",
		"sync-beads": "node scripts/sync-beads.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.2.0",
		"@earendil-works/pi-ai": "^1.2.0",
		"@earendil-works/pi-durable": "^1.2.0",
		"acorn": "^8.19.0",
		"acorn-walk": "^8.3.5",
		"preact": "^11.0.1",
		"quickjs-wasi": "3.6.2"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261014.1",
		"@commander-js/extra-typings": "~15.0.0",
		"@hegeldev/hegel": "^0.4.7",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"commander": "~15.0.0",
		"esbuild": "^0.28.2",
		"hdr-histogram-js": "^3.0.1",
		"typescript": "^7.0.2",
		"undici": "^8.11.2",
		"vitest": "^4.1.11"
	}
}
